# Orbit backend settings for the public deployment (api.orbitcosmetics.qd.je).
# install-service.sh copies this to ~/.config/orbit-backend.env (readable by you only). Edit that copy.
# No passwords or secrets go in here.

# production: writes need a Minecraft account verified with Mojang. Never use "development" publicly.
ORBIT_MODE=production

# Where the database and uploaded cosmetics live. Keep them outside the source folder so updates and
# backups are simple. Use absolute paths.
ORBIT_DATA_DIR=/home/YOUR_USER/orbit-data
ORBIT_STORAGE_DIR=/home/YOUR_USER/orbit-data/cosmetics

# The website may read the catalogue from the browser.
ORBIT_CORS_ORIGINS=https://orbitcosmetics.qd.je

# Limits
ORBIT_MAX_UPLOAD_BYTES=1048576
ORBIT_MAX_STORAGE_MB=1024
ORBIT_UPLOADS_PER_PLAYER_PER_DAY=20
ORBIT_SESSION_HOURS=24
ORBIT_REQUESTS_PER_MINUTE=240
ORBIT_AUTH_REQUESTS_PER_MINUTE=10

# Cloudflare Tunnel connects from this machine and reports the visitor's address in CF-Connecting-IP.
ORBIT_TRUST_PROXY_HEADERS=1

# Discord webhook for report alerts (3 different reporters) and automatic bans (6). It is a secret: anyone with
# it can post in the channel. Paste it into your copy of this file (or your host's secret settings) only.
ORBIT_DISCORD_WEBHOOK_URL=
# Reports are dropped after this many days; automatic bans last ORBIT_REPORT_BAN_DAYS.
ORBIT_REPORT_RETENTION_DAYS=7
ORBIT_REPORT_ALERT_THRESHOLD=3
ORBIT_REPORT_BAN_THRESHOLD=6
ORBIT_REPORT_BAN_DAYS=7
ORBIT_REPORTS_PER_PLAYER_PER_DAY=20

# Discord moderation bot: its token goes in backend/.env as TOKEN=... (not here). 1 runs it inside the API
# process; otherwise run discord_bot.py as its own service (install-service.sh does this).
ORBIT_DISCORD_BOT=0
